{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task": {
      "enum": [
        "outline",
        "inspiration",
        "revision",
        "male_gaze"
      ]
    },
    "brief": {
      "type": "string",
      "minLength": 0,
      "maxLength": 30000
    },
    "character": {
      "type": "string",
      "minLength": 0,
      "maxLength": 30000
    },
    "scene": {
      "type": "string",
      "minLength": 0,
      "maxLength": 30000
    },
    "instructions": {
      "type": "string",
      "minLength": 0,
      "maxLength": 6000
    },
    "proposal": {
      "type": "object"
    },
    "accepted_edits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^E[0-9]{1,4}$"
      },
      "maxItems": 100,
      "uniqueItems": true
    }
  },
  "required": [
    "task"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "outline"
          }
        }
      },
      "then": {
        "required": [
          "brief"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "inspiration"
          }
        }
      },
      "then": {
        "required": [
          "brief",
          "character"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "enum": [
              "revision",
              "male_gaze"
            ]
          }
        }
      },
      "then": {
        "required": [
          "scene"
        ]
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task": {
      "enum": [
        "outline",
        "inspiration",
        "revision",
        "male_gaze"
      ]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "edits": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{1,4}$"
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          },
          "after": {
            "type": "string",
            "minLength": 0,
            "maxLength": 30000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        },
        "required": [
          "id",
          "before",
          "occurrence",
          "after",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      },
      "maxItems": 30
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      },
      "maxItems": 30
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      },
      "maxItems": 30
    }
  },
  "required": [
    "schema_version",
    "task",
    "input_hash",
    "summary",
    "questions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "enum": [
              "revision",
              "male_gaze"
            ]
          }
        }
      },
      "then": {
        "required": [
          "edits"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "content"
              ]
            },
            {
              "required": [
                "notes"
              ]
            },
            {
              "required": [
                "assumptions"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "content",
          "notes",
          "assumptions"
        ],
        "not": {
          "required": [
            "edits"
          ]
        }
      }
    }
  ]
}
